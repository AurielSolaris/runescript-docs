---
import Icon from "./Icon.astro";
import ThemeMenu from "./ThemeMenu.astro";
import { nav, site } from "../lib/site";

const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
// The most specific nav entry that contains this page is the current one.
const current = nav
  .filter((n) => path === n.href || path.startsWith(`${n.href}/`))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<header class="topnav" x-data="drawer" @keydown.escape.window="close()">
  <div class="topnav__inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img src="/favicon.svg" alt="" width="24" height="24" />
      <span>{site.name}</span>
    </a>

    <nav class="topnav__links" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} aria-current={n.href === current ? "page" : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="topnav__actions">
      <ThemeMenu />
      <a class="btn btn--subtle btn--icon" href={site.repo} aria-label="RuneScript on GitHub" rel="noopener">
        <Icon name="github" />
      </a>
      <button
        class="btn btn--subtle btn--icon topnav__menu-btn"
        type="button"
        :aria-expanded="open.toString()"
        aria-expanded="false"
        aria-controls="mobile-nav"
        :aria-label="open ? 'Close menu' : 'Open menu'"
        aria-label="Open menu"
        @click="toggle()"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Main" x-show="open" x-cloak x-transition.opacity.duration.150ms>
    {nav.map((n) => (
      <a class="menu-item" href={n.href} aria-current={n.href === current ? "page" : undefined} @click="close()">
        {n.label}
      </a>
    ))}
    <a class="menu-item" href={site.repo} rel="noopener">
      GitHub <Icon name="external" class="menu-item__check" />
    </a>
  </nav>
</header>

<style lang="scss">
  @use "../styles/mixins" as *;

  .topnav {
    position: sticky;
    top: 0;
    z-index: 200;
    background: var(--ds-surface);
    border-bottom: 1px solid var(--ds-border);
    // Clears the status bar when launched from the iOS home screen.
    padding-top: env(safe-area-inset-top);
  }

  .topnav__inner {
    display: flex;
    align-items: center;
    gap: var(--ds-space-300);
    height: var(--nav-height);
    @include gutter-inline;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-space-100);
    color: var(--ds-text);
    font: var(--ds-font-heading-small);
    border-radius: var(--ds-radius-small);
    &:hover { text-decoration: none; }
  }

  .topnav__links {
    display: none;
    gap: var(--ds-space-050);
    height: 100%;
    @include up(s) { display: flex; }

    a {
      position: relative;
      display: inline-flex;
      align-items: center;
      padding: 0 var(--ds-space-100);
      color: var(--ds-text-subtle);
      font-weight: var(--ds-font-weight-medium);
      border-radius: var(--ds-radius-small);

      &:hover { color: var(--ds-text); text-decoration: none; }
      &:focus-visible { outline-offset: -2px; }
      &[aria-current="page"] {
        color: var(--ds-text-selected);
        &::after {
          content: "";
          position: absolute;
          left: var(--ds-space-100);
          right: var(--ds-space-100);
          bottom: -1px;
          height: 2px;
          background: var(--ds-border-selected);
        }
      }
    }
  }

  .topnav__actions {
    display: flex;
    align-items: center;
    gap: var(--ds-space-050);
    margin-inline-start: auto;
  }

  .topnav__menu-btn {
    @include up(s) { display: none; }
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding: var(--ds-space-050) 0 var(--ds-space-100);
    border-top: 1px solid var(--ds-border);
    @include gutter-inline(0px);
    @include up(s) { display: none !important; }

    .menu-item {
      min-height: 2.75rem; // 44px touch target
      padding-inline: var(--page-margin);
      &:hover { text-decoration: none; }
      &[aria-current="page"] {
        background: var(--ds-background-selected);
        color: var(--ds-text-selected);
        box-shadow: inset 2px 0 0 var(--ds-border-selected);
      }
    }
  }
</style>
