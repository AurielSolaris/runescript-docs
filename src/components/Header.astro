---
import Icon from "./Icon.astro";
import ThemeMenu from "./ThemeMenu.astro";
import LanguageMenu from "./LanguageMenu.astro";
import { site } from "../lib/site";
import { localeInfo, localeOf, ui } from "../lib/i18n";

const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const locale = localeOf(path);
const t = ui[locale];
const p = localeInfo[locale].prefix;
// Only the guide is translated: Examples, the specification, and the roadmap are English pages.
const nav = [
  { href: `${p}/docs`, label: t.docs, en: false },
  { href: "/examples", label: t.examples, en: locale !== "en" },
  { href: "/docs/spec", label: t.spec, en: locale !== "en" },
  { href: "/docs/roadmap", label: t.roadmap, en: locale !== "en" },
];
// The most specific nav entry that contains this page is the current one.
const current = nav
  .filter((n) => path === n.href || path.startsWith(`${n.href}/`))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<header class="topnav" x-data="drawer" @keydown.escape.window="close()">
  <div class="topnav__inner">
    <a class="brand" href={p || "/"} aria-label={t.home}>
      <img src="/favicon.svg" alt="" width="24" height="24" />
      <span>{site.name}</span>
    </a>

    <nav class="topnav__links" aria-label={t.mainNav}>
      {nav.map((n) => (
        <a href={n.href} hreflang={n.en ? "en" : undefined} aria-current={n.href === current ? "page" : undefined}>
          {n.label}{n.en && <span class="visually-hidden"> {t.inEnglish}</span>}
        </a>
      ))}
    </nav>

    <div class="topnav__actions">
      <LanguageMenu />
      <ThemeMenu />
      <a class="btn btn--ghost btn--icon" href={site.repo} aria-label={t.github} rel="noopener">
        <Icon name="github" />
      </a>
      <button
        class="btn btn--ghost btn--icon topnav__menu-btn"
        type="button"
        :aria-expanded="open.toString()"
        aria-expanded="false"
        aria-controls="mobile-nav"
        :aria-label={`open ? ${JSON.stringify(t.closeMenu)} : ${JSON.stringify(t.openMenu)}`}
        aria-label={t.openMenu}
        @click="toggle()"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label={t.mainNav} x-show="open" x-cloak x-transition.opacity.duration.150ms>
    {nav.map((n) => (
      <a class="menu-item" href={n.href} hreflang={n.en ? "en" : undefined} aria-current={n.href === current ? "page" : undefined} @click="close()">
        {n.label}{n.en && <span class="visually-hidden"> {t.inEnglish}</span>}
      </a>
    ))}
    <a class="menu-item" href={site.repo} rel="noopener">
      GitHub <Icon name="external" class="menu-item__check" />
    </a>
  </nav>
</header>

<style lang="scss">
  @use "../styles/mixins" as *;

  .topnav {
    position: sticky;
    top: 0;
    z-index: 200;
    background: var(--rs-bg);
    border-bottom: 1px solid var(--rs-border);
    // Clears the status bar when launched from the iOS home screen.
    padding-top: env(safe-area-inset-top);
  }

  .topnav__inner {
    display: flex;
    align-items: center;
    gap: var(--rs-space-6);
    height: var(--nav-height);
    @include gutter-inline;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--rs-space-2);
    color: var(--rs-text);
    font: var(--rs-font-h4);
    border-radius: var(--rs-radius-2);
    &:hover { text-decoration: none; }
  }

  .topnav__links {
    display: none;
    gap: var(--rs-space-1);
    height: 100%;
    @include up(s) { display: flex; }

    a {
      position: relative;
      display: inline-flex;
      align-items: center;
      padding: 0 var(--rs-space-2);
      color: var(--rs-text-muted);
      font-weight: var(--rs-weight-medium);
      border-radius: var(--rs-radius-2);

      &:hover { color: var(--rs-text); text-decoration: none; }
      &:focus-visible { outline-offset: -2px; }
      &[aria-current="page"] {
        color: var(--rs-text-selected);
        &::after {
          content: "";
          position: absolute;
          left: var(--rs-space-2);
          right: var(--rs-space-2);
          bottom: -1px;
          height: 2px;
          background: var(--rs-border-selected);
        }
      }
    }
  }

  .topnav__actions {
    display: flex;
    align-items: center;
    gap: var(--rs-space-1);
    margin-inline-start: auto;
  }

  .topnav__menu-btn {
    @include up(s) { display: none; }
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding: var(--rs-space-1) 0 var(--rs-space-2);
    border-top: 1px solid var(--rs-border);
    @include gutter-inline(0px);
    @include up(s) { display: none !important; }

    .menu-item {
      min-height: 2.75rem; // 44px touch target
      padding-inline: var(--page-margin);
      &:hover { text-decoration: none; }
      &[aria-current="page"] {
        background: var(--rs-bg-selected);
        color: var(--rs-text-selected);
        box-shadow: inset 2px 0 0 var(--rs-border-selected);
        &:dir(rtl) { box-shadow: inset -2px 0 0 var(--rs-border-selected); }
      }
    }
  }
</style>
