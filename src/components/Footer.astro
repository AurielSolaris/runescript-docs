---
import { site } from "../lib/site";

const groups = [
  {
    title: "Learn",
    links: [
      { href: "/docs/getting-started", label: "Getting started" },
      { href: "/docs", label: "Guide" },
      { href: "/examples", label: "Examples" },
      { href: "/docs/coming-from-actionscript", label: "Coming from ActionScript 3" },
    ],
  },
  {
    title: "Reference",
    links: [
      { href: "/docs/spec", label: "Language specification" },
      { href: "/docs/diagnostics", label: "Diagnostics" },
      { href: "/docs/std-string", label: "std:string" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: "/docs/roadmap", label: "Roadmap" },
      { href: site.repo, label: "Source code" },
      { href: `${site.repo}/issues`, label: "Report an issue" },
    ],
  },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo">
        <img src="/favicon.svg" alt="" width="20" height="20" loading="lazy" />
        {site.name}
      </a>
      <p>A strict, statically typed language with ActionScript roots. Implemented in Go.</p>
      <p class="footer__meta">v{site.version} · early development</p>
    </div>
    {groups.map((g) => (
      <nav class="footer__group" aria-label={g.title}>
        <h2>{g.title}</h2>
        <ul>
          {g.links.map((l) => (
            <li><a href={l.href} rel={l.href.startsWith("http") ? "noopener" : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
</footer>

<style lang="scss">
  @use "../styles/mixins" as *;

  .footer {
    margin-top: var(--rs-space-20);
    border-top: 1px solid var(--rs-border);
    background: var(--rs-bg-sunken);
    padding-block: var(--rs-space-12) calc(var(--rs-space-12) + env(safe-area-inset-bottom));
  }

  .footer__inner {
    display: grid;
    gap: var(--rs-space-8);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    @include up(m) { grid-template-columns: 2fr repeat(3, 1fr); }
  }

  .footer__brand {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--rs-space-2);
    align-content: start;
    max-width: 22rem;
    color: var(--rs-text-muted);
    @include up(m) { grid-column: auto; }
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--rs-space-2);
    color: var(--rs-text);
    font: var(--rs-font-h4);
    &:hover { text-decoration: none; }
  }

  .footer__meta { font: var(--rs-font-caption); color: var(--rs-text-faint); }

  .footer__group {
    h2 { font: var(--rs-font-h6); color: var(--rs-text-faint); margin-bottom: var(--rs-space-3); }
    ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--rs-space-2); }
    a { color: var(--rs-text-muted); &:hover { color: var(--rs-text); } }
  }
</style>
