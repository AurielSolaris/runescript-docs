---
import { Code } from "astro:components";
import Icon from "./Icon.astro";
import { runescript } from "../lib/runescript.grammar";
import { codeTheme } from "../lib/shiki";

interface Props {
  code: string;
  lang?: "runescript" | "sh" | "text" | "actionscript-3";
  filename?: string;
  class?: string;
}

const { code, lang = "runescript", filename, class: className } = Astro.props;
---

<figure class:list={["code-block", "cb", className]} x-data="copy">
  {filename && (
    <figcaption class="cb__title">
      <Icon name="file" />
      <span>{filename}</span>
    </figcaption>
  )}
  <div x-ref="code">
    <Code code={code} lang={lang === "runescript" ? runescript : lang} theme={codeTheme} />
  </div>
  <button
    class="btn btn--secondary btn--compact code-block__copy"
    type="button"
    aria-label="Copy code"
    :aria-label="copied ? 'Copied' : 'Copy code'"
    :data-copied="copied ? '' : null"
    @click="run()"
  >
    <span x-show="!copied"><Icon name="copy" /></span>
    <span x-show="copied" x-cloak><Icon name="check" /></span>
  </button>
</figure>

<style lang="scss">
  .cb__title {
    display: flex;
    align-items: center;
    gap: var(--rs-space-1-5);
    padding: var(--rs-space-2) var(--rs-space-4);
    border-bottom: 1px solid var(--rs-border);
    color: var(--rs-text-muted);
    font: var(--rs-font-caption);
    font-family: var(--rs-font-mono);
  }
  .cb:has(.cb__title) .code-block__copy { top: var(--rs-space-1-5); }
</style>
