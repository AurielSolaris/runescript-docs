---
import Icon from "./Icon.astro";

const options = [
  { mode: "light", label: "Light", icon: "sun" },
  { mode: "dark", label: "Dark", icon: "moon" },
  { mode: "system", label: "Match system", icon: "monitor" },
] as const;
---

<div
  class="theme-menu"
  x-data="menu"
  @keydown.escape="close()"
  @click.outside="close(false)"
  @focusout="$el.contains($event.relatedTarget) || close(false)"
>
  <button
    x-ref="trigger"
    class="btn btn--subtle btn--icon"
    type="button"
    aria-haspopup="menu"
    aria-expanded="false"
    :aria-expanded="open.toString()"
    aria-label="Theme"
    @click="toggle()"
  >
    <span class="theme-menu__icon theme-menu__icon--light"><Icon name="sun" /></span>
    <span class="theme-menu__icon theme-menu__icon--dark"><Icon name="moon" /></span>
  </button>
  <div
    x-ref="panel"
    class="popup theme-menu__panel"
    role="menu"
    aria-label="Theme"
    x-show="open"
    x-cloak
    @keydown.arrow-down.prevent="move(1)"
    @keydown.arrow-up.prevent="move(-1)"
  >
    {options.map((o) => (
      <button
        class="menu-item"
        type="button"
        role="menuitemradio"
        tabindex="-1"
        aria-checked="false"
        :aria-checked={`($store.theme.mode === '${o.mode}').toString()`}
        @click={`$store.theme.set('${o.mode}'); close()`}
      >
        <Icon name={o.icon} />
        {o.label}
        <span class="menu-item__check" x-show={`$store.theme.mode === '${o.mode}'`}><Icon name="check" /></span>
      </button>
    ))}
  </div>
</div>

<style lang="scss">
  .theme-menu { position: relative; }

  .theme-menu__panel {
    right: 0;
    top: calc(100% + var(--ds-space-100));
    min-width: 12rem;
  }

  // Show the icon for the theme actually in effect.
  .theme-menu__icon { display: contents; }
  .theme-menu__icon--dark { display: none; }

  :global(:root[data-theme="dark"]) {
    .theme-menu__icon--light { display: none; }
    .theme-menu__icon--dark { display: contents; }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) {
      .theme-menu__icon--light { display: none; }
      .theme-menu__icon--dark { display: contents; }
    }
  }
</style>
