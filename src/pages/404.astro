---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <div class="container nf">
    <span class="badge badge--neutral">404</span>
    <h1>We can't find that page</h1>
    <p>It may have moved when the docs were reorganised. Try the guide, or head back to the start.</p>
    <div class="nf__actions">
      <a class="btn btn--primary" href="/docs">Go to the docs <Icon name="arrow-right" /></a>
      <a class="btn btn--secondary" href="/">Home</a>
    </div>
  </div>
</Base>

<style lang="scss">
  .nf {
    display: grid;
    gap: var(--rs-space-4);
    justify-items: start;
    max-width: 40rem;
    padding-block: var(--rs-space-20);
    h1 { font: var(--rs-font-h1); }
    p { font: var(--rs-font-body); color: var(--rs-text-muted); }
  }
  .nf__actions { display: flex; flex-wrap: wrap; gap: var(--rs-space-2); }
</style>
