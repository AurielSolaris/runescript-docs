---
// The translated guide chapters: /bn/docs/<slug> and /heb/docs/<slug>.
import { getCollection, render } from "astro:content";
import Docs from "../../../layouts/Docs.astro";

export async function getStaticPaths() {
  const entries = await getCollection("translations", (e) => e.data.page !== "");
  return entries.map((entry) => ({ params: { lang: entry.id.split("/")[0], slug: entry.data.page }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Docs
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.data.page}
  section="Guide"
  headings={headings}
  source={entry.data.source}
>
  <Content />
</Docs>
